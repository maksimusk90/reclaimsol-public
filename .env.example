# ReclaimSOL environment template
# Copy to .env.local for local development.
# Never commit real credentials or production secrets.

# Application
NEXT_PUBLIC_APP_NAME=ReclaimSOL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Network must be explicitly set. Use devnet for local development.
# Production currently runs on mainnet-beta; production values are managed outside this template.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Set true only when intentionally running a read-only validation build.
# Production transaction mode is enabled in the protected deployment configuration.
NEXT_PUBLIC_RECLAIMSOL_READ_ONLY=false

# Devnet RPC only. This value is public and must not contain a private provider key.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Mainnet Helius proxy credentials (server-only; never NEXT_PUBLIC_*).
# Mainnet client requests use the same-origin /api/solana/rpc route.
# Keep provider credentials out of NEXT_PUBLIC_* variables and source control.
# HELIUS_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_PRIMARY_KEY
# HELIUS_MAINNET_RPC_FALLBACK_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_SECONDARY_KEY

# Public treasury address. This is a public address, not a secret.
# Production treasury configuration is managed in the protected deployment environment.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Public client-side service fee configuration (1500 = 15%).
# This is not a secret and is not an on-chain enforcement mechanism.
NEXT_PUBLIC_RECLAIMSOL_SERVICE_FEE_BPS=1500
RECLAIMSOL_DEFAULT_PRIORITY_FEE_MICROLAMPORTS=0

# Optional server API protection / RPC proxy configuration.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60